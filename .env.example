# Крот: переменные окружения
# Скопируй в .env для локальной разработки (или задай их в Railway, Variables).
# БЕЗ BOT_TOKEN сервер запускается в DEV MODE: авторизация подменяется одним
# локальным игроком. Удобно для локальных тестов.

# Из @BotFather (/newbot). Обязателен в продакшене.
BOT_TOKEN=

# Публичный HTTPS адрес приложения (Railway его выдаёт),
# например https://krot-production.up.railway.app
# Нужен для вебхука Telegram и кнопки «Играть» (web_app).
APP_URL=

# Имя бота без @ (для приглашений и диплинков в комнату).
BOT_USERNAME=krot_play_bot

# Секретный сегмент пути для вебхука Telegram (любая случайная строка).
WEBHOOK_SECRET=change-me-to-something-random

# Подписывает сессионные JWT (любая длинная случайная строка).
JWT_SECRET=change-me-to-a-long-random-string

# Где лежит SQLite. На Railway укажи примонтированный том, например /data
DATA_DIR=./data

# Порт (Railway задаёт автоматически).
PORT=3000
